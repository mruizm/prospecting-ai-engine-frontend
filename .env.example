# --- server/ (BFF) ---
# Base URL of the prospecting-ai-engine-backend API, no trailing slash.
PROSPECTING_ENGINE_URL=http://localhost:8000

# Internal engine API key. Never sent to the browser — the BFF attaches it
# server-side as X-API-Key on every proxied request. Must match the
# backend's `api_key` setting (see prospecting-ai-engine-backend/.env.example).
PROSPECTING_API_KEY=change-me

# Shared-secret gate for this tool while the team has no SSO wired up.
# Anyone with this password gets a session cookie; treat it like a
# password, not a public value. Replace with real SSO before wider rollout
# (see docs/PLAN.md, "Open questions for the backend team").
CONSOLE_SESSION_PASSWORD=change-me

# Random 32+ byte string used to sign session cookies.
CONSOLE_SESSION_SECRET=replace-with-a-long-random-string

# Port the BFF listens on. In production it also serves app/dist.
PORT=4000

# Set only if this server sits behind a reverse proxy that terminates TLS
# (nginx, an ALB, Cloud Run, etc.) — usually "1" (trust one hop). Required
# for the session cookie's `secure` flag to work correctly in production;
# see the comment on `trustProxy` in server/src/env.ts before deploying.
TRUST_PROXY=

# Angular's development proxy targets the BFF at http://localhost:4000 via
# app/proxy.conf.json. No browser-visible environment variable is required.
